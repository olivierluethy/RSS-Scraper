#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Server profile launcher.

This used to be a standalone copy of the watcher. It is now a thin launcher over
the single-source ``rss_watcher`` package so there is only one implementation to
maintain (issue #6). Configuration — including the ntfy topic, which must no
longer be hardcoded (issue #3) — lives in a YAML file:

    cp config.example.yaml config.yaml   # then edit config.yaml
    NTFY_TOPIC=... python server-version

By default it looks for ``config.yaml`` next to this script; override with
``--config PATH``.
"""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from rss_watcher.watcher import main

if __name__ == "__main__":
    argv = sys.argv[1:]
    if "--config" not in argv and "-c" not in argv:
        argv = ["--config", os.path.join(_HERE, "config.yaml")] + argv
    raise SystemExit(main(argv))
