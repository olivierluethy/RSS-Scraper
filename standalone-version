#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Standalone profile launcher.

A thin launcher over the single-source ``rss_watcher`` package (issue #6) that
defaults to the slim standalone config (5 feeds + a "still alive" status ping):

    cp config.standalone.example.yaml config.standalone.yaml   # then edit
    NTFY_TOPIC=... python standalone-version

Override the config path with ``--config PATH``.
"""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from rss_watcher.watcher import main

if __name__ == "__main__":
    argv = sys.argv[1:]
    if "--config" not in argv and "-c" not in argv:
        argv = ["--config", os.path.join(_HERE, "config.standalone.yaml")] + argv
    raise SystemExit(main(argv))
